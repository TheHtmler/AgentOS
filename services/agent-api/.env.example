OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=agentos-qwen3vl:16k
# Model context window (num_ctx in the Ollama Modelfile); drives input budgeting.
MODEL_CONTEXT_WINDOW=16384
# Output budget per model turn. Prompt instructions control ordinary answer length.
# The custom Qwen3-VL instance uses a 16k context window (see infra/ollama/Modelfile.agentos-qwen3vl-16k).
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_TEMPERATURE=0.3
# Start with one stream to keep the 16 GB Mac mini within its model/KV-cache budget.
MODEL_MAX_CONCURRENT_RUNS=1
HISTORY_MAX_RUNS=4
AUTH_SESSION_TTL_DAYS=30
AUTH_INVITE_TTL_MINUTES=1440
# Comma-separated accounts allowed to create invitation links after signing in.
AUTH_ADMIN_EMAILS=admin@example.com
WEB_APP_ORIGIN=http://127.0.0.1:3000

# Ops console root (independent from AUTH_ADMIN_EMAILS / invite users).
# Simplest: set OPS_ROOT_PASSWORD to a plaintext password (home / Mac mini).
# Optional harder mode: OPS_ROOT_PASSWORD_HASH (Argon2id); hash wins if both are set.
OPS_ROOT_USERNAME=admin
OPS_ROOT_PASSWORD=
OPS_ROOT_PASSWORD_HASH=
OPS_SESSION_TTL_HOURS=12

SEARCH_ENABLED=true
SEARCH_PROVIDER_ORDER=tavily,duckduckgo
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=20
SEARCH_MAX_RESULTS=5

DATABASE_URL=postgresql+asyncpg://agentos:replace-with-a-local-development-password@127.0.0.1:5432/agentos

# fetch_url: Firecrawl preferred, local HTML extract failover (see fetch-url design spec).
FETCH_URL_ENABLED=true
FETCH_PROVIDER_ORDER=firecrawl,local
FIRECRAWL_API_KEY=
FETCH_URL_TIMEOUT_SECONDS=20
# Preview size for the model (full page is stored as Artifact when enabled).
# Keep bounded for the 16k-context local model; use read_artifact to continue.
FETCH_URL_MAX_CHARS=2500
# After Artifact persist, model only sees this short preview/outline.
FETCH_URL_ARTIFACT_PREVIEW_CHARS=1000
FETCH_URL_ARTIFACT_OUTLINE_CHARS=600

# Artifact: persist fetch bodies in Postgres; read_artifact for offset windows.
ARTIFACT_ENABLED=true
ARTIFACT_PERSIST_ON_FETCH=true
ARTIFACT_MAX_CHARS=200000
READ_ARTIFACT_MAX_CHARS=6000

# Built-in WHO 2006 growth assessment (anthro); no external API key.
GROWTH_ASSESS_ENABLED=true
# Platform util tools: time_diff + calculate (deterministic; no external API).
UTIL_TOOLS_ENABLED=true
# Built-in keyword search over curated knowledge_chunks
# (seed: uv run python scripts/seed_knowledge.py → seed/knowledge/mma_pa_chunks.json).
KNOWLEDGE_SEARCH_ENABLED=true

# Mac mini PaddleOCR HTTP (knowledge PDF import + chat report uploads). Prefer loopback.
# OCR_ENABLED=true
# OCR_BASE_URL=http://127.0.0.1:8787
# OCR_API_KEY=
# OCR_TEXT_MIN_CHARS=40
# OCR_TIMEOUT_SECONDS=60

# Chat report uploads: local originals (gitignored under services/agent-api/data/uploads).
# UPLOAD_ROOT=services/agent-api/data/uploads
# UPLOAD_MAX_BYTES=20000000
# UPLOAD_MAX_FILES_PER_MESSAGE=3
# Attach original images / PDF page renders to Qwen3-VL when analyzing uploads.
# UPLOAD_VISION_ENABLED=true
# UPLOAD_VISION_MAX_IMAGES=3
# UPLOAD_VISION_MAX_PDF_PAGES=2

# Tool policy overrides (comma-separated tool names). Deny beats ask.
# Example: TOOL_POLICY_DENY=fetch_url
# Example: TOOL_POLICY_ASK=fetch_url
TOOL_POLICY_DENY=
TOOL_POLICY_ASK=
# Pending HITL approvals expire after this many seconds (auto-deny + continue).
HITL_APPROVAL_TIMEOUT_SECONDS=1800

# Auto-generate a short thread title after the first successful run (model summary).
AUTO_THREAD_TITLE_ENABLED=true
AUTO_THREAD_TITLE_TIMEOUT_SECONDS=30

# Extract durable Agent-scoped user facts after successful runs.
MEMORY_EXTRACT_ENABLED=true
MEMORY_EXTRACT_TIMEOUT_SECONDS=30
MEMORY_RECALL_TOP_K=8
MEMORY_RECALL_MAX_CHARS=2000
# Hybrid note recall (profile slots are always injected without embeddings).
MEMORY_EMBEDDING_ENABLED=true
# Pull with: ollama pull nomic-embed-text
MEMORY_EMBEDDING_MODEL=nomic-embed-text
# Knowledge chunk hybrid search (reuses MEMORY_EMBEDDING_MODEL).
KNOWLEDGE_EMBEDDING_ENABLED=true

# Fixed endpoint for background jobs (auto thread titles, memory/case extraction)
# and embedding calls. Deliberately decoupled from any Agent's chat provider:
# republishing an Agent never reroutes where patient data is sent. Leave empty to
# fall back to the local Ollama settings above; point all at a remote
# OpenAI-compatible endpoint to retire local models entirely. After changing
# BACKGROUND_EMBEDDING_MODEL, re-import affected documents via Ops
# (POST /v1/ops/knowledge/import) to re-embed their chunks — vectors from
# different models are never mixed. BACKGROUND_VISION_MODEL must point at a
# vision-capable model; it has no fallback, since BACKGROUND_CHAT_MODEL is
# usually text-only — leaving it empty disables Ops PDF/image knowledge import.
# The api_key never enters the DB or any API response.
# BACKGROUND_BASE_URL=https://your-openai-compatible-gateway/v1
# BACKGROUND_API_KEY=
# BACKGROUND_CHAT_MODEL=
# BACKGROUND_EMBEDDING_MODEL=
# BACKGROUND_VISION_MODEL=
# Optional dedicated endpoint for the vision import calls only — lets per-page
# transcription live on a different gateway than embeddings/chat (e.g. vision on
# a GPT relay while embeddings stay on OpenRouter). Empty falls back to
# BACKGROUND_BASE_URL/BACKGROUND_API_KEY. Parsed text is always vectorized by
# BACKGROUND_EMBEDDING_MODEL via the shared endpoint, never by the vision one.
# BACKGROUND_VISION_BASE_URL=
# BACKGROUND_VISION_API_KEY=
# Complex or high-resolution images may need more time than local OCR.
# BACKGROUND_VISION_TIMEOUT_SECONDS=180

# Read-only MCP (stdio). Default off. When enabled with empty MCP_STDIO_COMMAND,
# AgentOS starts the built-in PubMed readonly server
# (python -m agent_api.tools.mcp.servers.pubmed_readonly).
# Trailing underscore on MCP_TOOL_PREFIX is optional (mcp_ and mcp both → mcp_* tools).
MCP_ENABLED=false
MCP_STDIO_COMMAND=
MCP_TOOL_ALLOWLIST=pubmed_search,pubmed_get_abstract
MCP_TOOL_PREFIX=mcp_

# Case archive extract after successful runs (case-enabled Agents only).
CASE_EXTRACT_ENABLED=true
CASE_EXTRACT_TIMEOUT_SECONDS=30
CASE_CONTEXT_READ_ENABLED=true

# User-level Docker Sandbox (opt-in). The manager is a separate internal service.
# Keep the manager on loopback/private networking; never expose Docker directly.
SANDBOX_ENABLED=false
SANDBOX_MANAGER_URL=http://127.0.0.1:8788
SANDBOX_MANAGER_TOKEN=
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_OUTPUT_CHARS=32000
SANDBOX_OUTPUT_PREVIEW_CHARS=6000

# Injected into every Run (authoritative "now" + language preference).
RUNTIME_TIMEZONE=Asia/Shanghai
RUNTIME_LOCALE=zh-CN
