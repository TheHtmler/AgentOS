# Keep this service private. Agent API sends this exact token in
# X-AgentOS-Sandbox-Token.
SANDBOX_MANAGER_TOKEN=replace-with-a-long-random-token
SANDBOX_WORKSPACE_ROOT=/Users/your-user/agentos-sandbox-workspaces
SANDBOX_IMAGE=python:3.13-slim
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_MAX_TIMEOUT_SECONDS=300
SANDBOX_MAX_OUTPUT_CHARS=32000
# Maximum size served through the owner-scoped chat preview/download endpoint.
SANDBOX_FILE_MAX_BYTES=20000000
# Per-user workspace disk quota (1 GiB). A run that pushes its workspace past
# this size is killed; free space before running more commands.
SANDBOX_WORKSPACE_MAX_BYTES=1073741824
SANDBOX_MAX_CONCURRENT_RUNS=1
SANDBOX_PORT=8788
