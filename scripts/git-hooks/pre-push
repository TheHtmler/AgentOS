#!/usr/bin/env bash
# Slower pre-push gate: full backend pytest against the isolated test database.
#
# Installed by scripts/install-git-hooks.sh. Intentionally not in
# pre-commit — pytest needs a running local Postgres and is too slow to
# gate every commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/services/agent-api"

echo "==> pytest (services/agent-api)"
if ! uv run pytest -q; then
  echo ""
  echo "pytest failed. Tests never connect to the business database."
  echo "On the deployment host, prepare the isolated database with:"
  echo "  cd services/agent-api && uv run python scripts/prepare_test_database.py"
  echo "(escape hatch: git push --no-verify — do not use for real regressions)"
  exit 1
fi

exit 0
