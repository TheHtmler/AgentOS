<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily PostgreSQL backup with rotation (keeps 14 by default).
  Runs at 03:30. Logs to /tmp/agentos-backup.log.
  Install: ./scripts/install-launchd.sh backup
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.agentos-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__AGENTOS_ROOT__/scripts/backup-postgres.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/agentos-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agentos-backup.log</string>
</dict>
</plist>
